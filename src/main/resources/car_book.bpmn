      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=role = "staff" or role = "head"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="ApproveByHead" name="Trưởng phòng duyệt">
